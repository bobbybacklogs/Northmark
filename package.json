{
  "name": "northmark",
  "version": "1.0.0",
  "description": "Give every product a clear direction. Northmark reads a codebase and drafts product-alignment docs with ModelHitch.",
  "keywords": [
    "cli",
    "docs",
    "documentation",
    "product",
    "readme",
    "modelhitch",
    "northmark"
  ],
  "license": "MIT",
  "author": "cass",
  "type": "module",
  "bin": {
    "northmark": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "assets",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bobbybacklogs/Northmark.git"
  },
  "bugs": {
    "url": "https://github.com/bobbybacklogs/Northmark/issues"
  },
  "homepage": "https://github.com/bobbybacklogs/Northmark#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/chmod-cli.mjs",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "lint": "eslint .",
    "test": "vitest run",
    "prepack": "npm run build",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "commander": "^14.0.2",
    "ignore": "^7.0.5",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.19.0",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^3.2.4"
  }
}
